<%- include('../layout', { body: '' }) %>

<h1>Edit Module</h1>

<form method="POST" action="/modules/<%= module.id %>/edit">
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input class="form-control" name="name" value="<%= module.name %>" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Base Path</label>
    <input class="form-control" name="base_path" value="<%= module.base_path %>" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Status</label>
    <select class="form-select" name="status">
      <option value="active" <% if (module.status === 'active') { %>selected<% } %>>Active</option>
      <option value="inactive" <% if (module.status === 'inactive') { %>selected<% } %>>Inactive</option>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">Updated By</label>
    <input class="form-control" name="updated_by" />
  </div>
  <button class="btn btn-primary" type="submit">Save Changes</button>
  <a class="btn btn-link" href="/modules/<%= module.id %>">Cancel</a>
</form>
