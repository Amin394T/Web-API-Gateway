<%- include('../layout', { body: '' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Modules</h1>
  <a class="btn btn-primary" href="/modules/new">Create Module</a>
</div>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Base Path</th>
      <th>Status</th>
      <th>Routes</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (modules.length === 0) { %>
      <tr><td colspan="5">No modules yet.</td></tr>
    <% } %>
    <% modules.forEach(m => { %>
      <tr>
        <td><%= m.name %></td>
        <td><%= m.base_path %></td>
        <td><%= m.status %></td>
        <td><%= m.routes ? m.routes.length : 0 %></td>
        <td><a class="btn btn-sm btn-outline-secondary" href="/modules/<%= m.id %>">View</a></td>
      </tr>
    <% }); %>
  </tbody>
</table>
