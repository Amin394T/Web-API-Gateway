<%- include('../layout', { body: '' }) %>

<h1>Edit Route</h1>

<form method="POST" action="/modules/<%= module.id %>/routes/<%= route.id %>/edit">
  <div class="mb-3">
    <label class="form-label">Method</label>
    <select class="form-select" name="method">
      <option <% if (route.method === 'GET') { %>selected<% } %>>GET</option>
      <option <% if (route.method === 'POST') { %>selected<% } %>>POST</option>
      <option <% if (route.method === 'PUT') { %>selected<% } %>>PUT</option>
      <option <% if (route.method === 'DELETE') { %>selected<% } %>>DELETE</option>
      <option <% if (route.method === 'PATCH') { %>selected<% } %>>PATCH</option>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">URI Path</label>
    <input class="form-control" name="uri_path" value="<%= route.uri_path %>" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Cache Time (seconds)</label>
    <input class="form-control" name="cache_time" type="number" value="<%= route.cache_time %>" />
  </div>
  <div class="mb-3">
    <label class="form-label">Code (JavaScript)</label>
    <textarea class="form-control" name="code" rows="10" style="font-family: monospace;"><%= route.code %></textarea>
  </div>
  <div class="mb-3">
    <label class="form-label">Updated By</label>
    <input class="form-control" name="updated_by" />
  </div>
  <button class="btn btn-primary" type="submit">Save Changes</button>
  <a class="btn btn-link" href="/modules/<%= module.id %>">Cancel</a>
</form>
