<%- include('../layout', { body: '' }) %>

<h1>Add Route to <%= module.name %></h1>

<form method="POST" action="/modules/<%= module.id %>/routes">
  <div class="mb-3">
    <label class="form-label">Method</label>
    <select class="form-select" name="method">
      <option>GET</option>
      <option>POST</option>
      <option>PUT</option>
      <option>DELETE</option>
      <option>PATCH</option>
    </select>
  </div>
  <div class="mb-3">
    <label class="form-label">URI Path</label>
    <input class="form-control" name="uri_path" placeholder="/items" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Cache Time (seconds)</label>
    <input class="form-control" name="cache_time" type="number" value="0" />
  </div>
  <div class="mb-3">
    <label class="form-label">Code (JavaScript)</label>
    <textarea class="form-control" name="code" rows="10" placeholder="// Write your JavaScript code here&#10;res.json({ message: 'Hello' });" style="font-family: monospace;"></textarea>
  </div>
  <div class="mb-3">
    <label class="form-label">Created By</label>
    <input class="form-control" name="created_by" />
  </div>
  <button class="btn btn-primary" type="submit">Add Route</button>
  <a class="btn btn-link" href="/modules/<%= module.id %>">Cancel</a>
</form>
