<%- include('../layout', { body: '' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h1><%= module.name %></h1>
    <div><strong>Base Path:</strong> <%= module.base_path %></div>
    <div><strong>Status:</strong> <%= module.status %></div>
    <div><strong>Created:</strong> <%= module.created_on %> by <%= module.created_by %></div>
  </div>
  <div>
    <a class="btn btn-sm btn-primary" href="/modules/<%= module.id %>/routes/new">Add Route</a>
    <a class="btn btn-sm btn-outline-info" href="/modules/<%= module.id %>/edit">Edit</a>
    <form method="POST" action="/modules/<%= module.id %>/delete" style="display:inline;">
      <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Delete this module?')">Delete</button>
    </form>
    <a class="btn btn-sm btn-outline-secondary" href="/modules">Back</a>
  </div>
</div>

<h3>Routes</h3>
<table class="table table-hover">
  <thead>
    <tr>
      <th>Method</th>
      <th>URI Path</th>
      <th>Cache</th>
      <th>Code Preview</th>
      <th>Created</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (!module.routes || module.routes.length === 0) { %>
      <tr><td colspan="6">No routes yet.</td></tr>
    <% } %>
    <% (module.routes || []).forEach(r => { %>
      <tr>
        <td><%= r.method %></td>
        <td><%= r.uri_path %></td>
        <td><%= r.cache_time %>s</td>
        <td>
          <% if (r.code && r.code.length > 0) { %>
            <code style="white-space: pre-wrap; word-break: break-word; display: block; max-height: 60px; overflow: hidden; font-size: 0.75rem;"><%= r.code.substring(0, 100) %><% if (r.code.length > 100) { %>...<% } %></code>
          <% } else { %>
            <span class="text-muted">—</span>
          <% } %>
        </td>
        <td><%= r.created_on %> by <%= r.created_by %></td>
        <td>
          <a class="btn btn-xs btn-outline-info" href="/modules/<%= module.id %>/routes/<%= r.id %>/edit">Edit</a>
          <form method="POST" action="/modules/<%= module.id %>/routes/<%= r.id %>/delete" style="display:inline;">
            <button class="btn btn-xs btn-outline-danger" type="submit" onclick="return confirm('Delete this route?')">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>
